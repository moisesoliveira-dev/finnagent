# Copie para .env e preencha com os segredos de desenvolvimento.
# Sem valores. No Compose local, PORT, REDIS_URL, API_URL, AGENTS_URL,
# OTEL_SERVICE_NAME, DATABASE_URL e DIRECT_URL saem do compose.yaml.
# No Railway, DATABASE_URL e DIRECT_URL continuam sendo as do Supabase.
#
# APP_ENV vazio vale production, com login obrigatório. development dispensa o login
# e só funciona fora do Railway. Vale para o frontend e para o backend.

APP_ENV=

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
SENTRY_DSN=
LOG_LEVEL=

NEXT_PUBLIC_SENTRY_DSN=
API_URL=

# App mobile (apps/mobile): endereço público do frontend, o BFF. Só vale na hora do build do app.
VITE_API_URL=

DATABASE_URL=
DIRECT_URL=
REDIS_URL=
AGENTS_URL=
AUTH_EMAIL_DONO=moiseixas123@gmail.com

OPENAI_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

PORT=