generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Group {
  id          String    @id
  tenantId    String    @map("tenant_id")
  name        String
  description String    @default("")
  sessions    Session[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("groups")
}

model Session {
  id          String  @id
  tenantId    String  @map("tenant_id")
  groupId     String  @map("group_id")
  name        String
  description String  @default("")
  cents       Int     @default(0)
  group       Group   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  entries     Entry[]

  @@unique([tenantId, groupId, name])
  @@index([tenantId])
  @@map("sessions")
}

model Workflow {
  tenantId String @id @map("tenant_id")
  year     Int
  month    Int
  day      Int

  @@map("workflows")
}

model Entry {
  id            String        @id
  tenantId      String        @map("tenant_id")
  sessionId     String        @map("session_id")
  type          String
  description   String
  justification String        @default("")
  day           Int
  cents         Int
  startYear     Int           @map("start_year")
  startMonth    Int           @map("start_month")
  installments  Int?
  position      Int           @default(0)
  session       Session       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  amounts       EntryAmount[]
  appointments  Appointment[]
  statementLines StatementLine[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("entries")
}

model EntryAmount {
  entryId  String @map("entry_id")
  tenantId String @map("tenant_id")
  year     Int
  month    Int
  cents    Int
  entry    Entry  @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Cascade)

  @@id([entryId, year, month])
  @@index([tenantId])
  @@map("entry_amounts")
}

model Appointment {
  id        String  @id
  tenantId  String  @map("tenant_id")
  title     String
  year      Int
  month     Int
  day       Int
  hour      Int?
  minute    Int?
  calendar  String
  category  String  @default("unico")
  endYear   Int?    @map("end_year")
  endMonth  Int?    @map("end_month")
  endDay    Int?    @map("end_day")
  entryId   String? @map("entry_id")
  entry     Entry?  @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, year, month])
  @@index([tenantId])
  @@map("appointments")
}

model Account {
  id         String      @id
  tenantId   String      @map("tenant_id")
  name       String
  statements Statement[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("accounts")
}

model Statement {
  id                String          @id
  tenantId          String          @map("tenant_id")
  accountId         String          @map("account_id")
  filename          String
  format            String
  status            String
  message           String          @default("")
  startDate         DateTime?       @map("start_date") @db.Date
  endDate           DateTime?       @map("end_date") @db.Date
  lineCount         Int             @map("line_count")
  errorCount        Int             @map("error_count")
  importedAt        DateTime        @map("imported_at")
  content           Bytes
  contentHash       String          @map("content_hash")
  dateColumn        Int?            @map("date_column")
  descriptionColumn Int?            @map("description_column")
  amountColumn      Int?            @map("amount_column")
  account           Account         @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)
  lines             StatementLine[]

  @@unique([tenantId, id])
  @@index([tenantId, accountId, startDate, endDate])
  @@index([tenantId])
  @@map("statements")
}

model StatementLine {
  statementId String    @map("statement_id")
  tenantId    String    @map("tenant_id")
  line        Int
  postedOn    DateTime? @map("posted_on") @db.Date
  description String
  cents       Int?
  error       String    @default("")
  entryId     String?   @map("entry_id")
  statement   Statement @relation(fields: [tenantId, statementId], references: [tenantId, id], onDelete: Cascade)
  entry       Entry?    @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)

  @@id([statementId, line])
  @@index([tenantId])
  @@map("statement_lines")
}

model Goal {
  id          String @id
  tenantId    String @map("tenant_id")
  name        String
  targetCents Int    @map("target_cents")
  savedCents  Int    @default(0) @map("saved_cents")
  dueYear     Int?   @map("due_year")
  dueMonth    Int?   @map("due_month")

  @@index([tenantId])
  @@map("goals")
}

model Outbox {
  id             String    @id
  tenantId       String    @map("tenant_id")
  operation      String
  idempotencyKey String    @map("idempotency_key")
  payload        String
  publishedAt    DateTime? @map("published_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, publishedAt])
  @@map("outbox")
}

model ConsumedEvent {
  idempotencyKey String   @id @map("idempotency_key")
  tenantId       String   @map("tenant_id")
  consumedAt     DateTime @default(now()) @map("consumed_at")

  @@map("consumed_events")
}
