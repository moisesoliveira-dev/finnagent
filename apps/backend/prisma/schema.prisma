generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Group {
  id          String    @id
  tenantId    String    @map("tenant_id")
  name        String
  description String    @default("")
  // A ordem que a pessoa escolheu arrastando; 1 é o primeiro.
  position    Int       @default(0)
  sessions    Session[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("groups")
}

model Session {
  id            String            @id
  tenantId      String            @map("tenant_id")
  groupId       String            @map("group_id")
  name          String
  description   String            @default("")
  justification String            @default("")
  startedAt     DateTime?         @map("started_at") @db.Date
  endedAt       DateTime?         @map("ended_at") @db.Date
  cents         Int               @default(0)
  kind          String            @default("acumulo")
  // Acúmulo: o teto de saídas por mês. Sem valor, sem limite.
  limitCents    Int?              @map("limit_cents")
  // A ordem dentro do grupo, escolhida arrastando; 1 é a primeira.
  position      Int               @default(0)
  group         Group             @relation(fields: [groupId], references: [id], onDelete: Restrict)
  entries       Entry[]
  additions     SessionAddition[]
  aliases       StatementAlias[]
  appointments  Appointment[]

  @@index([tenantId])
  @@map("sessions")
}

model SessionAddition {
  id        String   @id
  tenantId  String   @map("tenant_id")
  sessionId String   @map("session_id")
  cents     Int
  note      String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("session_additions")
}

model YearStay {
  tenantId  String   @map("tenant_id")
  year      Int
  decidedAt DateTime @default(now()) @map("decided_at")

  @@id([tenantId, year])
  @@map("year_stays")
}

model Workflow {
  tenantId String @id @map("tenant_id")
  year     Int
  month    Int
  day      Int

  @@map("workflows")
}

model Entry {
  id                 String              @id
  tenantId           String              @map("tenant_id")
  sessionId          String              @map("session_id")
  type               String
  description        String              @default("")
  justification      String              @default("")
  day                Int
  cents              Int
  startYear          Int                 @map("start_year")
  startMonth         Int                 @map("start_month")
  installments       Int?
  position           Int                 @default(0)
  name               String              @default("")
  occurredOn         DateTime            @map("occurred_on") @db.Date
  mode               String              @default("outflows")
  status             String              @default("pending")
  transactionType    String              @default("unusual") @map("transaction_type")
  category           String              @default("fixed")
  priority           String              @default("nopriority")
  installmentNumber  Int?                @map("installment_number")
  dueOn              DateTime?           @map("due_on") @db.Date
  interestBps        Int?                @map("interest_bps")
  nextDueOn          DateTime?           @map("next_due_on") @db.Date
  suspendedCents     Int                 @default(0) @map("suspended_cents")
  commitmentId       String?             @map("commitment_id")
  recurrence         String?
  recurrenceInterval Int?                @map("recurrence_interval")
  // Regra de vencimento: como cada data cai em dia útil. O padrão é o dia como está.
  dueRule            String              @default("dia") @map("due_rule")
  dueOrder           Int?                @map("due_order")
  dueShift           String              @default("manter") @map("due_shift")
  dueCount           String              @default("bancaria") @map("due_count")
  coveredById        String?             @map("covered_by_id")
  // De que conta o dinheiro sai ou em que conta entra. Opcional: sem conta, só a sobra conta.
  accountId          String?             @map("account_id")
  // Transferência entre contas da própria pessoa: muda o saldo das contas, não a sobra do mês.
  transfer           Boolean             @default(false)
  // Os dois lados de uma transferência (sai de uma conta, entra na outra) dividem este id.
  pairId             String?             @map("pair_id")
  // A sobra de um mês levada para o seguinte: o mês (AAAA-MM) de onde ela veio. O sistema cria e recalcula.
  carryOf            String?             @map("carry_of")
  // Empréstimo: de quem é e o total combinado. O saldo é o total menos o que já foi pago.
  counterparty       String              @default("")
  principalCents     Int?                @map("principal_cents")
  account            Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  session            Session             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  coveredBy          Entry?              @relation("Cobertura", fields: [coveredById], references: [id], onDelete: SetNull)
  covers             Entry[]             @relation("Cobertura")
  amounts            EntryAmount[]
  adjustments        EntryAdjustment[]
  occurrences        EntryOccurrence[]
  appointments       Appointment[]
  statementLines     StatementLine[]
  statementLineParts StatementLinePart[]
  statementAliases   StatementAlias[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([coveredById])
  @@index([accountId])
  @@index([pairId])
  @@unique([tenantId, carryOf])
  @@map("entries")
}

model EntryOccurrence {
  tenantId     String    @map("tenant_id")
  entryId      String    @map("entry_id")
  number       Int
  dueOn        DateTime  @map("due_on") @db.Date
  plannedCents Int       @map("planned_cents")
  paidCents    Int?      @map("paid_cents")
  paidOn       DateTime? @map("paid_on") @db.Date
  status       String    @default("pending")
  // parcela ou multa (o que foi pago a mais numa parcela atrasada).
  kind         String    @default("parcela")
  // Na parcela e no empréstimo: qual parcela do contrato esta ocorrência é.
  parcel       Int?
  // O pagamento (linha do extrato ou registro à mão) que resolveu a ocorrência; serve para desfazer.
  paymentId    String?   @map("payment_id")
  entry        Entry     @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, entryId, number])
  @@index([tenantId])
  @@map("entry_occurrences")
}

model EntryAdjustment {
  entryId  String @map("entry_id")
  tenantId String @map("tenant_id")
  year     Int
  month    Int
  effect   String
  entry    Entry  @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Cascade)

  @@id([entryId, year, month])
  @@index([tenantId])
  @@map("entry_adjustments")
}

model EntryAmount {
  entryId  String @map("entry_id")
  tenantId String @map("tenant_id")
  year     Int
  month    Int
  cents    Int
  entry    Entry  @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Cascade)

  @@id([entryId, year, month])
  @@index([tenantId])
  @@map("entry_amounts")
}

model Appointment {
  id            String   @id
  tenantId      String   @map("tenant_id")
  title         String
  description   String   @default("")
  location      String   @default("")
  startAt       DateTime @map("start_at")
  endAt         DateTime @map("end_at")
  allDay        Boolean  @default(false) @map("all_day")
  status        String   @default("undone")
  year          Int
  month         Int
  day           Int
  hour          Int?
  minute        Int?
  calendar      String
  category      String   @default("fixed")
  endYear       Int?     @map("end_year")
  endMonth      Int?     @map("end_month")
  endDay        Int?     @map("end_day")
  entryId       String?  @map("entry_id")
  sessionId     String?  @map("session_id")
  googleEventId String?  @map("google_event_id")
  // Depois do fim, perguntar se teve gasto.
  askSpending   Boolean  @default(true) @map("ask_spending")
  entry         Entry?   @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)
  session       Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  spendings     AppointmentSpending[]
  checklist     Task[]

  @@unique([tenantId, googleEventId])
  @@index([tenantId, year, month])
  @@index([sessionId])
  @@index([tenantId])
  @@map("appointments")
}

model Calendar {
  id       String @id
  tenantId String @map("tenant_id")
  name     String
  timezone String

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("calendars")
}

// A aba Hoje: as tarefas que a pessoa escreve, por dia. A que não foi feita segue para o dia seguinte.
model Task {
  id        String    @id
  tenantId  String    @map("tenant_id")
  title     String
  date      DateTime  @db.Date
  doneOn    DateTime? @map("done_on") @db.Date
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  // Só na raiz: a regra de repetição ("daily", "weekdays", "weekly", "monthly"). Ao ser feita, nasce a próxima.
  repeat    String?
  // A subatividade aponta para a atividade, em qualquer profundidade. Apagar a atividade apaga as filhas.
  parentId  String?   @map("parent_id")
  parent    Task?     @relation("Subtarefas", fields: [parentId], references: [id], onDelete: Cascade)
  children  Task[]    @relation("Subtarefas")
  // Item do checklist de um compromisso, no dia da ocorrência (`date`). A árvore toda leva o compromisso. Apagar o
  // compromisso apaga o checklist.
  appointmentId String?      @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, date])
  @@index([tenantId, parentId])
  @@index([tenantId, appointmentId, date])
  @@map("tasks")
}

model Account {
  id           String      @id
  tenantId     String      @map("tenant_id")
  name         String
  // conta: banco, carteira. cartao: cartão de crédito, cujas compras viram a fatura.
  kind         String      @default("conta")
  // O saldo no dia em que a pessoa começou a controlar a conta aqui, e esse dia. Só o que acontece a partir dele
  // conta no saldo; sem data, tudo conta (contas de antes da data existir).
  openingCents Int         @default(0) @map("opening_cents")
  openingOn    DateTime?   @map("opening_on") @db.Date
  // Cartão: o dia em que a fatura fecha, o dia em que vence e o limite. Sem fechamento e vencimento, não há fatura.
  closingDay   Int?        @map("closing_day")
  dueDay       Int?        @map("due_day")
  limitCents   Int?        @map("limit_cents")
  statements   Statement[]
  entries      Entry[]
  boxes        AccountBox[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("accounts")
}

// Caixinha (depósito) dentro de uma conta. Cada uma tem uma sessão no grupo "Caixinhas": nela entram o rendimento do
// mês, as aplicações e os resgates. Ligada a uma meta, o saldo dela conta no guardado da meta.
model AccountBox {
  id           String  @id
  tenantId     String  @map("tenant_id")
  accountId    String  @map("account_id")
  name         String
  // O que já estava na caixinha quando a pessoa começou a controlar aqui, e esse dia.
  openingCents Int       @default(0) @map("opening_cents")
  openingOn    DateTime? @map("opening_on") @db.Date
  sessionId    String    @map("session_id")
  goalId       String? @map("goal_id")
  account      Account @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, accountId, name])
  @@unique([tenantId, goalId])
  @@index([tenantId])
  @@map("account_boxes")
}

model Statement {
  id                String          @id
  tenantId          String          @map("tenant_id")
  accountId         String          @map("account_id")
  filename          String
  format            String
  status            String
  message           String          @default("")
  // O que a pessoa escreveu junto com o extrato. Ajuda a ler imagem e PDF e fica visível para quem conferir.
  note              String          @default("")
  startDate         DateTime?       @map("start_date") @db.Date
  endDate           DateTime?       @map("end_date") @db.Date
  lineCount         Int             @map("line_count")
  errorCount        Int             @map("error_count")
  importedAt        DateTime        @map("imported_at")
  content           Bytes
  contentHash       String          @map("content_hash")
  dateColumn        Int?            @map("date_column")
  descriptionColumn Int?            @map("description_column")
  amountColumn      Int?            @map("amount_column")
  account           Account         @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)
  lines             StatementLine[]

  @@unique([tenantId, id])
  @@index([tenantId, accountId, startDate, endDate])
  @@index([tenantId])
  @@map("statements")
}

model StatementLine {
  statementId  String              @map("statement_id")
  tenantId     String              @map("tenant_id")
  line         Int
  postedOn     DateTime?           @map("posted_on") @db.Date
  description  String
  cents        Int?
  error        String              @default("")
  entryId      String?             @map("entry_id")
  // O lançamento nasceu desta linha (acúmulo). Desfazer apaga esse lançamento em vez de reabrir.
  entryCreated Boolean             @default(false) @map("entry_created")
  // A pessoa marcou a linha como sem importância: ela sai da conferência e da contagem, mas não é apagada.
  ignoredAt    DateTime?           @map("ignored_at")
  statement    Statement           @relation(fields: [tenantId, statementId], references: [tenantId, id], onDelete: Cascade)
  entry        Entry?              @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)
  parts        StatementLinePart[]

  @@id([statementId, line])
  @@index([tenantId])
  @@index([tenantId, postedOn])
  @@map("statement_lines")
}

// Uma linha do extrato dividida em vários lançamentos. A linha aponta para a primeira parte (entryId), para contar
// como lançada; as partes guardam todos, para mostrar a divisão e desfazê-la.
model StatementLinePart {
  tenantId      String        @map("tenant_id")
  statementId   String        @map("statement_id")
  line          Int
  entryId       String        @map("entry_id")
  cents         Int
  position      Int
  // false: a parte pagou o lançamento que já existia (sessão fixa). Desfazer reabre esse, e apaga só os criados.
  created       Boolean       @default(true)
  statementLine StatementLine @relation(fields: [statementId, line], references: [statementId, line], onDelete: Cascade)
  entry         Entry         @relation(fields: [tenantId, entryId], references: [tenantId, id], onDelete: Restrict)

  @@id([statementId, line, entryId])
  @@index([tenantId])
  @@map("statement_line_parts")
}

// Os nomes que a pessoa já deu às linhas com a mesma descrição. A Conferência oferece esses nomes da próxima vez.
model StatementName {
  tenantId   String   @map("tenant_id")
  key        String
  name       String
  uses       Int      @default(1)
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@id([tenantId, key, name])
  @@index([tenantId, key])
  @@map("statement_names")
}

model StatementAlias {
  tenantId  String  @map("tenant_id")
  name      String
  sessionId String  @map("session_id")
  entryId   String? @map("entry_id")
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  entry     Entry?  @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@id([tenantId, name])
  @@index([tenantId])
  @@map("statement_aliases")
}

model Goal {
  id          String  @id
  tenantId    String  @map("tenant_id")
  name        String
  targetCents Int     @map("target_cents")
  savedCents  Int     @default(0) @map("saved_cents")
  dueYear     Int?    @map("due_year")
  dueMonth    Int?    @map("due_month")
  sessionId   String? @map("session_id")
  position    Int     @default(0)

  @@index([tenantId])
  @@map("goals")
}

// A parte da sobra de um mês que a pessoa reservou para uma meta. Só vira lançamento quando ela aprova.
model GoalAllocation {
  goalId        String @map("goal_id")
  tenantId      String @map("tenant_id")
  year          Int
  month         Int
  percent       Int
  approvedCents Int?   @map("approved_cents")

  @@id([goalId, year, month])
  @@index([tenantId, year, month])
  @@map("goal_allocations")
}

model Preference {
  tenantId               String   @id @map("tenant_id")
  name                   String   @default("")
  timezone               String
  theme                  String
  personalCalendar       Boolean  @default(true) @map("personal_calendar")
  workCalendar           Boolean  @default(true) @map("work_calendar")
  showEntries            Boolean  @default(true) @map("show_entries")
  categorize             String
  pendingHours           Int      @map("pending_hours")
  reminder               String
  reminders              Boolean  @default(true)
  dueAlerts              Boolean  @default(true) @map("due_alerts")
  emailAlerts            Boolean  @default(false) @map("email_alerts")
  appAlerts              Boolean  @default(true) @map("app_alerts")
  history                String
  googleClientId         String   @default("") @map("google_client_id")
  googleClientSecret     String   @default("") @map("google_client_secret")
  googleRefreshToken     String   @default("") @map("google_refresh_token")
  googleOauthState       String   @default("") @map("google_oauth_state")
  googleAccount          String   @default("") @map("google_account")
  googleCalendarPersonal String   @default("") @map("google_calendar_personal")
  googleCalendarWork     String   @default("") @map("google_calendar_work")
  aiApiKey               String   @default("") @map("ai_api_key")
  aiModels               String[] @default([]) @map("ai_models")
  aiModel                String   @default("") @map("ai_model")
  dueDefaults            Json     @default("{}") @map("due_defaults")
  showHolidays           Boolean  @default(true) @map("show_holidays")
  showOptionalHolidays   Boolean  @default(true) @map("show_optional_holidays")

  @@map("preferences")
}

model Outbox {
  id             String    @id
  tenantId       String    @map("tenant_id")
  operation      String
  idempotencyKey String    @map("idempotency_key")
  payload        String
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  publishedAt    DateTime? @map("published_at")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, publishedAt])
  @@map("outbox")
}

model ConsumedEvent {
  idempotencyKey String   @id @map("idempotency_key")
  tenantId       String   @map("tenant_id")
  consumedAt     DateTime @default(now()) @map("consumed_at")

  @@map("consumed_events")
}

// Cada tenant tem vários usuários e só um master. O Prisma não descreve índice único parcial,
// então `users_tenant_id_master_key` (UNIQUE (tenant_id) WHERE role = 'master') vive só na migration.
model User {
  id                  String               @id
  tenantId            String               @map("tenant_id")
  email               String               @unique
  name                String               @default("")
  headline            String               @default("")
  location            String               @default("")
  bio                 String               @default("")
  avatarTone          String               @default("brand") @map("avatar_tone")
  role                String               @default("membro")
  passwordHash        String               @map("password_hash")
  failedAttempts      Int                  @default(0) @map("failed_attempts")
  lockedUntil         DateTime?            @map("locked_until")
  createdAt           DateTime             @default(now()) @map("created_at")
  sessions            AuthSession[]
  notifications       Notification[]
  notificationSetting NotificationSetting?
  pushDevices         PushDevice[]

  @@index([tenantId])
  @@map("users")
}

model AuthSession {
  id        String   @id
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  userAgent String   @default("") @map("user_agent")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// Assistente de IA. A chave do provedor nunca sai do backend para a tela.
model AiProvider {
  id        String   @id
  tenantId  String   @map("tenant_id")
  kind      String
  label     String
  apiKey    String   @default("") @map("api_key")
  baseUrl   String   @default("") @map("base_url")
  models    String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("ai_providers")
}

model AiSettings {
  tenantId          String   @id @map("tenant_id")
  defaultProviderId String?  @map("default_provider_id")
  defaultModel      String   @default("") @map("default_model")
  roles             Json     @default("{}")
  confirmDeletes    Boolean  @default(true) @map("confirm_deletes")
  maxSteps          Int      @default(8) @map("max_steps")
  creativity        String   @default("precisa")
  instructions      String   @default("")
  retention         String   @default("1a")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("ai_settings")
}

model AiConversation {
  id          String         @id
  tenantId    String         @map("tenant_id")
  userId      String         @map("user_id")
  title       String
  pending     Json?
  // Fixada pela pessoa: fica no alto da lista e a retenção não apaga.
  pinned      Boolean        @default(false)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @map("updated_at")
  messages    AiMessage[]
  attachments AiAttachment[]

  @@index([tenantId, userId, updatedAt])
  @@map("ai_conversations")
}

// Arquivo que a pessoa anexou numa mensagem do chat. Some junto com a conversa.
model AiAttachment {
  id             String         @id
  tenantId       String         @map("tenant_id")
  conversationId String         @map("conversation_id")
  name           String
  mediaType      String         @map("media_type")
  size           Int
  content        Bytes
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId])
  @@map("ai_attachments")
}

model AiMessage {
  id             String         @id
  tenantId       String         @map("tenant_id")
  conversationId String         @map("conversation_id")
  role           String
  parts          Json
  agent          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId])
  @@map("ai_messages")
}

// Feriado da cidade ou do estado, cadastrado pela conta: repete todo ano no mesmo dia.
model Holiday {
  id        String   @id
  tenantId  String   @map("tenant_id")
  name      String
  day       Int
  month     Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, month, day])
  @@index([tenantId])
  @@map("holidays")
}

// Notificação de um usuário. `key` é a idempotência: o mesmo fato (vencimento, meta, extrato) avisa uma vez só.
model Notification {
  id        String    @id
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  kind      String
  title     String
  body      String
  target    String
  targetId  String?   @map("target_id")
  key       String
  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, userId, createdAt])
  @@map("notifications")
}

// O que cada usuário quer receber, por tipo e canal, e o horário de silêncio.
model NotificationSetting {
  userId     String   @id @map("user_id")
  tenantId   String   @map("tenant_id")
  channels   Json     @default("{}")
  quietOn    Boolean  @default(false) @map("quiet_on")
  quietStart String   @default("22:00") @map("quiet_start")
  quietEnd   String   @default("07:00") @map("quiet_end")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notification_settings")
}

// Onde o push chega: a inscrição do navegador (Web Push) ou o token do aparelho (Firebase).
model PushDevice {
  id         String   @id
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  kind       String
  endpoint   String   @unique
  p256dh     String   @default("")
  auth       String   @default("")
  platform   String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("push_devices")
}

// A resposta da pessoa à pergunta "teve gasto?" de uma ocorrência de compromisso: "none" (não teve) ou "entry"
// (virou o lançamento `entryId`). Uma por compromisso e dia.
model AppointmentSpending {
  id            String      @id
  tenantId      String      @map("tenant_id")
  appointmentId String      @map("appointment_id")
  date          DateTime    @db.Date
  answer        String
  entryId       String?     @map("entry_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, appointmentId, date])
  @@index([tenantId, date])
  @@map("appointment_spendings")
}
